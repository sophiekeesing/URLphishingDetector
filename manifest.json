{
  "manifest_version": 3,
  "name": "URL Shield — Phishing Link Checker",
  "version": "3.0.0",
  "description": "Warns you about likely phishing pages. Local checks by default; optional privacy-preserving Google Safe Browsing and DNS lookups you switch on yourself.",
  "action": {
    "default_popup": "index.html",
    "default_title": "URL Shield",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": ["activeTab", "storage"],
  "optional_permissions": ["tabs"],
  "optional_host_permissions": [
    "https://safebrowsing.googleapis.com/*",
    "https://cloudflare-dns.com/*",
    "https://dns.quad9.net/*"
  ]
}
