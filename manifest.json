{
  "manifest_version": 3,
  "name": "URL Shield — Phishing Link Checker",
  "version": "5.0.0",
  "description": "Blocks likely phishing pages, IP-logger links and disguised redirects before they load, using local checks plus Safe Browsing, DNS and domain-age lookups.",
  "action": {
    "default_popup": "index.html",
    "default_title": "URL Shield",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": [
    "https://safebrowsing.googleapis.com/*",
    "https://cloudflare-dns.com/*",
    "https://dns.quad9.net/*",
    "https://rdap.verisign.com/*",
    "https://tld-rdap.verisign.com/*",
    "https://rdap.publicinterestregistry.org/*",
    "https://rdap.identitydigital.services/*",
    "https://rdap.centralnic.com/*",
    "https://rdap.zdnsgtld.com/*",
    "https://rdap.radix.host/*",
    "https://rdap.gmoregistry.net/*",
    "https://pubapi.registry.google/*",
    "https://rdap.nominet.uk/*"
  ],
  "optional_permissions": ["webNavigation"],
  "optional_host_permissions": ["<all_urls>"]
}
